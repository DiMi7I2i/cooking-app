# Modèle de configuration nginx : ${HTTPS_PORT} est remplacé au démarrage du
# conteneur (envsubst de l'image nginx), les variables nginx ($host…) restent intactes.

# HTTP : redirige vers HTTPS (le partage natif sur téléphone exige HTTPS)
server {
    listen 80;

    # Santé du conteneur (healthcheck Docker), sans redirection
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host:${HTTPS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    root /usr/share/nginx/html;

    # Certificat de l'autorité locale (scripts/https-cert.sh --prod), monté depuis l'hôte
    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Upload d'images : 5 Mo max côté backend, plus le reste du formulaire
    client_max_body_size 10m;

    location /data/ {
        proxy_pass http://backend:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /uploads/ {
        proxy_pass http://backend:3000;
    }

    # Routes Vue Router (mode history) : renvoyer index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
