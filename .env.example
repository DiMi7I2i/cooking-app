# Configuration de la stack de production (docker-compose.prod.yml).
# Copier en .env (non versionné) et adapter : cp .env.example .env

# Ports sur lesquels l'appli est accessible depuis le réseau local.
# L'appli est servie en HTTPS (nécessaire au partage natif sur téléphone) ;
# le port HTTP ne fait que rediriger vers HTTPS.
HTTPS_PORT=443
HTTP_PORT=80

# Dossier du certificat HTTPS (server.crt + server.key), créé par :
#   scripts/https-cert.sh --prod
# Relatif à la racine du projet, ou absolu. Par défaut : certs
#CERTS_DIR=certs

# Compte administrateur MongoDB, créé au premier démarrage uniquement
# (changer ces valeurs ensuite n'a pas d'effet sur une base existante).
# Mot de passe : éviter les caractères @ : / ? # % (il est inséré dans une URL).
MONGO_USER=cooking
MONGO_PASSWORD=changez-moi

# Sauvegardes (backup.sh) — facultatif
# Dossier des archives (relatif à la racine du projet, ou absolu) ; idéalement un autre disque
#BACKUP_DIR=backups
# Nombre d'archives conservées (les plus anciennes sont supprimées)
#BACKUP_KEEP=14
