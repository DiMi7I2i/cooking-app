# Configuration de la stack de production (docker-compose.prod.yml).
# Copier en .env (non versionné) et adapter : cp .env.example .env

# Port HTTP sur lequel l'appli est accessible depuis le réseau local
HTTP_PORT=80

# Compte administrateur MongoDB, créé au premier démarrage uniquement
# (changer ces valeurs ensuite n'a pas d'effet sur une base existante).
# Mot de passe : éviter les caractères @ : / ? # % (il est inséré dans une URL).
MONGO_USER=cooking
MONGO_PASSWORD=changez-moi
